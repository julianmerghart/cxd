// --- PRIVACY HELPER ---
// Rounds usage numbers to the nearest thousand to protect individual activity patterns.
const privacyRound = (num) => {
  if (num < 1000) return "< 1,000";
  return (Math.floor(num / 1000) * 1000).toLocaleString() + "+";
};

// --- HIGH-FIDELITY VECTOR COASTLINE (Madagascar) ---
const MADAGASCAR_COASTLINE = [
  [49.29, -11.95], [49.80, -13.50], [50.40, -15.30], [49.40, -18.15], 
  [48.50, -21.00], [47.00, -25.00], [45.10, -25.60], [43.66, -23.35], 
  [44.50, -19.80], [44.40, -16.20], [47.80, -13.50], [49.29, -11.95]
];

const MOCKED_BOUNDARY = [
   [48.5, -11.0], [51.5, -15.0], [48.0, -26.5], 
   [43.0, -26.0], [42.5, -16.0], [48.5, -11.0]
];

// --- MAP VISUALIZER COMPONENT ---
const GeoMap = ({ userLat, userLon, status }) => {
  const canvasRef = useRef(null);

  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const width = canvas.width;
    const height = canvas.height;
    ctx.clearRect(0, 0, width, height);

    const lonsMap = MADAGASCAR_COASTLINE.map(p => p[0]);
    const latsMap = MADAGASCAR_COASTLINE.map(p => p[1]);
    const minLon = Math.min(...lonsMap);
    const maxLon = Math.max(...lonsMap);
    const minLat = Math.min(...latsMap);
    const maxLat = Math.max(...latsMap);

    const padding = 20;
    const scaleX = (width - padding * 2) / (maxLon - minLon);
    const scaleY = (height - padding * 2) / (maxLat - minLat);
    const scale = Math.min(scaleX, scaleY); 

    const project = (lon, lat) => {
      const x = (lon - minLon) * scale + (width - (maxLon - minLon) * scale) / 2;
      const y = height - ((lat - minLat) * scale + (height - (maxLat - minLat) * scale) / 2); 
      return [x, y];
    };

    // 1. Draw Physical Coastline (Red)
    ctx.beginPath();
    ctx.strokeStyle = '#ef4444'; 
    ctx.lineWidth = 1.5;
    ctx.setLineDash([]);
    MADAGASCAR_COASTLINE.forEach((p, i) => {
      const [x, y] = project(p[0], p[1]);
      if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    });
    ctx.stroke();
    ctx.fillStyle = 'rgba(239, 68, 68, 0.08)'; 
    ctx.fill();

    // 2. Draw Geofence (Dashed)
    ctx.beginPath();
    ctx.strokeStyle = status === 'VALID' ? '#34d399' : '#64748b'; 
    ctx.lineWidth = 2;
    ctx.setLineDash([6, 4]); 
    MOCKED_BOUNDARY.forEach((p, i) => {
      const [x, y] = project(p[0], p[1]);
      if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    });
    ctx.stroke();

    // 3. Draw User Location
    if (userLat && userLon) {
      const [ux, uy] = project(userLon, userLat);
      ctx.setLineDash([]);
      ctx.beginPath();
      ctx.fillStyle = status === 'VALID' ? '#34d399' : '#f43f5e';
      ctx.arc(ux, uy, 4, 0, Math.PI * 2);
      ctx.fill();
      ctx.beginPath();
      ctx.strokeStyle = status === 'VALID' ? '#34d399' : '#f43f5e';
      ctx.lineWidth = 1;
      ctx.arc(ux, uy, 12, 0, Math.PI * 2);
      ctx.stroke();
    }
  }, [userLat, userLon, status]);

  return (
    <div className="relative w-full h-64 rounded-xl bg-slate-900 border border-slate-700/50 overflow-hidden">
        <div className="absolute inset-0 bg-gradient-to-b from-slate-800/30 to-slate-900/30 pointer-events-none" />
        <canvas ref={canvasRef} width={320} height={256} className="relative z-10 w-full h-full" />
    </div>
  );
};

